{
  "manifest_version": 2,
  "name": "🔎 Threat Intel Search",
  "version": "2.0.0",
  "description": "Right-click an IP, domain, or hash for a compact OSINT panel: one-click lookups, plus an optional score from your own API keys.",
  "permissions": ["contextMenus", "tabs", "storage"],
  "optional_permissions": [
    "https://www.virustotal.com/*",
    "https://api.abuseipdb.com/*",
    "https://otx.alienvault.com/*"
  ],
  "background": {
    "scripts": ["common.js", "background.js"],
    "persistent": false
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
